# Copy this file to ".env" and fill in your real values:
#   cp .env.example .env
# ".env" is gitignored — never put real secrets in .env.example.
# bot.py auto-loads .env on startup (values do not override existing env vars).

# ---- REQUIRED: your Feishu/Lark Custom App credentials ----
# From the Feishu Developer Console > your app > "Credentials & Basic Info".
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# ---- Optional ----
# Where received messages are stored (default: ./conversation, which is gitignored).
# FEISHU_CONVERSATION_DIR=/absolute/path/to/conversation

# tmux pane id where Claude Code runs (the "paste it here" target).
# Auto-set by `python bridgectl.py init` — you usually don't edit this by hand.
# Verify a pane id with:  tmux list-panes -a -F '#{pane_id} #{pane_current_command}'
FEISHU_CLAUDE_PANE=%0

# Emoji reaction codes (Feishu UPPER_SNAKE names). If a reaction doesn't appear, check
# the bot log for a [react] FAILED line and try another code here, then restart the bot.
# Codes verified empirically: THINKING THUMBSUP OK SMILE HAMMER
FEISHU_EMOJI_WORKING=OnIt
FEISHU_EMOJI_DONE=Done

# Seconds after which a busy lock with a dead/missing deliver thread is treated as stale (default 300).
# FEISHU_STALE_SEC=300
