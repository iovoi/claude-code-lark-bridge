# Copy this file to ".env" and fill in your real values:
#   cp .env.example .env
# ".env" is gitignored — never put real secrets in .env.example.
# feishu_api.load_env() auto-loads .env on import (values do not override existing env vars).

# ---- REQUIRED: your Feishu/Lark Custom App credentials ----
# From the Feishu Developer Console > your app > "Credentials & Basic Info".
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# ---- Access control (recommended) ----
# Comma-separated allowlists. If BOTH are unset the bot answers anyone who can reach
# the Feishu app (and logs a warning). Set at least one in production.
#   open_ids — allowed senders (p2p DM senders); find via the bridge log.
#   chat_ids — allowed group/p2p conversations.
# FEISHU_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxx,ou_yyyyyyyyyyyyyyyy
# FEISHU_ALLOWED_CHAT_IDS=oc_xxxxxxxxxxxxxxxx

# ---- Workspace & runtime ----
# Directory Claude works in (cwd of every claude subprocess). Default: the repo root.
# FEISHU_WORKDIR=/path/to/project
# Max number of chats (scopes) with a turn in flight at once. Default 4.
# FEISHU_MAX_CONCURRENT=4
# Seconds with no stream events (and no pending approval) before a turn is "stuck" and
# auto-interrupted. Default 180.
# FEISHU_STUCK_TIMEOUT=180
# Path to the claude CLI. Default: `claude` on PATH.
# FEISHU_CLAUDE_BIN=claude

# ---- Tool approvals ----
# Tools on this list run WITHOUT an approval card (read-only by default). Anything else
# pauses the turn and posts an Approve / Deny / Deny+stop card in chat.
# FEISHU_AUTO_APPROVE_TOOLS=Read,Grep,Glob,WebSearch,WebFetch,TodoWrite
# Seconds an approval card waits before auto-denying. Default 300.
# FEISHU_APPROVAL_TIMEOUT=300
# Permission mode used only if approval cards are unavailable (e.g. the installed claude
# lacks --permission-prompt-tool). Default bypassPermissions.
# FEISHU_DEFAULT_PERMISSION_MODE=bypassPermissions

# ---- Streaming card ----
# Minimum gap between in-place card updates, in milliseconds. Default 1500.
# FEISHU_CARD_THROTTLE_MS=1500
# A turn runs this long (seconds) before any "Working..." progress card is sent
# (the OnIt emoji acknowledges receipt meanwhile). Shorter turns send the answer as text. Default 60.
# FEISHU_CARD_DEFER_SEC=60
# Once the progress card exists, update it every this many seconds. Default 30.
# FEISHU_CARD_INTERVAL_SEC=30

# ---- Emoji cycle (Feishu UPPER_SNAKE reaction codes) ----
FEISHU_EMOJI_WORKING=OnIt
FEISHU_EMOJI_DONE=Done

# ---- Optional ----
# Where sessions.json is kept (default: ./conversation, gitignored).
# FEISHU_CONVERSATION_DIR=/absolute/path/to/conversation
# Internal testing seam: set to "1" to skip starting the Feishu websocket (offline/tests).
# FEISHU_DISABLE_WS=0
